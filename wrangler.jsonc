{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "earth-atlas",
  "compatibility_date": "2026-10-18",
  // Live flights and the weather snapshot use the Worker; everything else is static.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/data/weather/latest.json", "/admin", "/admin/"]
  },
  // Anonymous usage statistics behind /admin (worker/stats.ts). The dashboard
  // passphrase is the STATS_TOKEN secret, set in the Cloudflare dashboard.
  "d1_databases": [
    { "binding": "STATS", "database_name": "earth-atlas-stats", "database_id": "c60d43c6-dd2d-4560-862b-ba300b00b61d" }
  ],
  // Every 15 minutes: start the data workflows on GitHub (worker/dispatch.ts).
  // Needs the GITHUB_DISPATCH_TOKEN secret; without it the Worker sends nothing.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
