{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "earth-atlas",
  "compatibility_date": "2026-10-18",
  // Live flights and the weather snapshot use the Worker; everything else is static.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/data/weather/latest.json"]
  },
  "observability": { "enabled": true }
}
